<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<AnchorPane fx:id="miContenedor" styleClass="pantalla" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.ClienteController">
   <children>
      <VBox spacing="14.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-header">
               <children>
                  <ImageView fitHeight="64.0" fitWidth="72.0" preserveRatio="true"><image><Image url="@../img/lobo-cine.svg" /></image></ImageView>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="app-title" text="Goldencineplanet" />
                        <Label styleClass="app-subtitle" text="Grandes historias, siempre aquí · Gestión de Clientes" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <ImageView fitHeight="62.0" fitWidth="72.0" preserveRatio="true"><image><Image url="@../img/popcorn.svg" /></image></ImageView>
               </children>
            </HBox>
            <HBox spacing="14.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox maxWidth="340.0" minWidth="340.0" prefWidth="340.0" spacing="8.0" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="Registro de Cliente" />
                        <Label styleClass="field-label" text="Tipo de documento" />
                        <ComboBox fx:id="cbxTipoDoc" maxWidth="1.7976931348623157E308" />
                        <Label styleClass="field-label" text="N° de documento" />
                        <TextField fx:id="txtDniRuc" />
                        <Label styleClass="field-label" text="Nombres / Razón social" />
                        <TextField fx:id="txtNombres" />
                        <Label styleClass="field-label" text="Representante legal (opcional)" />
                        <TextField fx:id="txtRepLegal" />
                        <Label styleClass="field-label" text="Edad" />
                        <TextField fx:id="txtEdad" />
                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#validarFormulario" styleClass="btn, btn-success" text="Guardar" />
                              <Button mnemonicParsing="false" onAction="#clearForm" styleClass="btn, btn-warning" text="Cancelar" />
                           </children>
                           <padding>
                              <Insets top="6.0" />
                           </padding>
                        </HBox>
                        <Label fx:id="lbnMsg" maxWidth="1.7976931348623157E308" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="card-title" text="Listado de Clientes" />
                        <TableView fx:id="tableView" styleClass="tabla" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>

